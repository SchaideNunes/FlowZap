# ==============================================================================
# FLOW-ZAP: Variáveis de Ambiente
# Copie este arquivo para .env e preencha com as suas credenciais reais
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Servidor Backend
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase (Configuração do Banco na Nuvem)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# Segurança e Autenticação (JWT)
# Gere uma chave aleatória e segura (ex: openssl rand -base64 32)
JWT_SECRET=uma_chave_jwt_muito_segura_com_mais_de_32_caracteres_aleatorios_12345
JWT_EXPIRES_IN=7d

# Evolution API (WhatsApp Gateway)
# Se rodando no Docker local: http://localhost:8080 (ou http://evolution-api:8080 no docker-compose)
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=flowzap_super_secret_evolution_key_2026
EVOLUTION_INSTANCE_NAME=flowzap_cobranca

# Configurações Anti-Ban WhatsApp
# Timer com jitter aleatório entre envios consecutivos (em segundos)
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
# Simular "digitando..." antes do envio para comportamento humano
SIMULATE_TYPING=true
# Horário do agendador automático (Cron diário, padrão 09:00 da manhã)
CRON_SCHEDULE=0 9 * * *
